# xdev configuration — the canonical reference for every XDEV_* variable.
#
# The service manager (systemd on Linux, launchd on macOS) loads this file and
# passes it to xdev as the environment, so xdev can be configured entirely from
# here with no flags. Precedence is: explicit flag > env var > built-in default.
#
# install.sh writes a populated copy to:
#   Linux:  /etc/xdev/xdev.env            (0640, root)
#   macOS:  ~/Library/Application Support/xdev/xdev.env
#
# Edit, then restart the service (systemctl restart xdev / launchctl kickstart).

# --- core --------------------------------------------------------------------
# Data directory: holds xdev.db (sqlite) and backups/. Persists across upgrades.
XDEV_DATA=/var/lib/xdev
# Generated per-project / per-app compose stacks live here.
XDEV_PROJECTS=/var/lib/xdev/projects
# Web UI listen address — keep it bound to loopback and reach it via SSH tunnel.
XDEV_ADDR=127.0.0.1:7331
# Set the Secure flag on cookies. Enable when the UI is served over HTTPS.
XDEV_SECURE=true

# --- engine ------------------------------------------------------------------
# Container engine: docker | podman. Leave unset to auto-detect.
XDEV_ENGINE=docker

# --- proxy & TLS -------------------------------------------------------------
# Supervise Caddy as a child process (true), or run/manage Caddy yourself (false).
# Set false to use the containerized Caddy in deploy/caddy/docker-compose.yml.
XDEV_CADDY=true
# Caddy admin API address xdev pushes routes to (loopback).
XDEV_CADDY_ADMIN=127.0.0.1:2019
# Admin listen address to re-assert in every pushed config. REQUIRED for the
# containerized Caddy (deploy/caddy): without it a config reload drops Caddy's
# admin off its published binding and xdev loses its control channel. Leave EMPTY
# for supervised/systemd Caddy (admin stays on loopback). Match caddy-init.json.
XDEV_CADDY_ADMIN_LISTEN=
# Host that loopback upstreams (app/fpm ports published on the host) are dialed
# as. Keep 127.0.0.1 when Caddy runs on the host. When Caddy is a container it
# can't reach the host's loopback across the VM, so set it to the engine's host
# alias: host.containers.internal (podman) or host.docker.internal (docker).
XDEV_UPSTREAM_HOST=127.0.0.1
# Where Caddy sees the host filesystem. Serve-mode static apps are file-served
# from a real host path (a folder under projects/, or one you pointed the app
# at), and a containerized Caddy can only open what is mounted into it — so the
# generated stack mounts "/" read-only at /hostfs and this prefixes every
# file_server root with it. Leave EMPTY when Caddy runs on the host, where the
# paths already match. Does not affect shared-WP docroots: those must stay the
# real path so the fpm container resolves the same file.
XDEV_CADDY_ROOT_PREFIX=
# Public ports for proxied sites. Use 8443/8080 for sudo-free local dev.
XDEV_HTTPS_PORT=443
XDEV_HTTP_PORT=80
# Preview sites over plain HTTP: also serve routes on the HTTP port with no
# HTTP->HTTPS redirect. Handy on alt ports where no cert can be issued (e.g.
# migrating behind another proxy). Leave false for normal deploys.
XDEV_DISABLE_HTTPS_REDIRECT=false
# Contact email for Let's Encrypt (production domains). Required for prod ACME.
XDEV_ACME_EMAIL=ops@example.com
# Validity of locally-issued (.test/.localhost) TLS certs; keep under ~8000h.
XDEV_LOCAL_CERT_LIFETIME=2160h

# --- hosts (servers: off) ----------------------------------------------------
# Hosts file to manage local domains in (local dev only).
XDEV_HOSTS_FILE=/etc/hosts
# Auto-write local domains into the hosts file. Turn OFF on a real server —
# production sites resolve via real DNS.
XDEV_MANAGE_HOSTS=false

# --- app images --------------------------------------------------------------
# Pin the image Laravel apps serve from. Leave unset (the default) and xdev
# picks per project environment and per host architecture: a local project
# prefers leyume/swoole:2.0.0-dev and a prod one prefers :2.0.0-prod, falling
# back to whichever variant is actually published for this machine. Which that
# is gets read from the registry at app-create time, so republishing a tag as
# multi-arch takes effect on its own — no xdev upgrade needed. `xdev doctor`
# prints what this machine will get. Set this to your own image (a private
# registry, a pinned digest) to bypass the choice entirely.
#XDEV_LARAVEL_IMAGE=docker.io/leyume/swoole:2.0.0-prod
