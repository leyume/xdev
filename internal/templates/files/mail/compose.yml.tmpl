# Generated by xdev — Mail: Stalwart (SMTP/IMAP + admin UI) + SnappyMail webmail.
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# First run:
#   - Stalwart prints its auto-generated admin password in the mail service
#     logs. Log in at this app's admin domain, add your mail domain and
#     mailboxes there — it also lists the exact MX/SPF/DKIM/DMARC DNS records
#     to create at your DNS provider.
#   - SnappyMail writes its admin password to the webmail volume at
#     _data_/_default_/admin_password.txt. Open /?admin on the app domain and
#     point your domain at IMAP host "mail" port 143, SMTP "mail" port 587.
services:
  mail:
    image: docker.io/stalwartlabs/stalwart:latest
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_mail
    restart: unless-stopped
    volumes:
      - mail_data:/opt/stalwart
    ports:
      # Admin UI + JMAP; Caddy proxies the app's admin domain here.
      - "{{.AdminerPort}}:8080"
{{- if eq .Env "prod"}}
      - "25:25"    # SMTP (server-to-server delivery)
      - "465:465"  # SMTPS submission
      - "587:587"  # submission (STARTTLS)
      - "993:993"  # IMAPS
{{- else}}
      # ponytail: high ports locally — rootless podman can't bind <1024.
      - "2525:25"
      - "4650:465"
      - "5870:587"
      - "9930:993"
{{- end}}
{{- if .HasLimits}}
    deploy:
      resources:
        limits:
{{- if .CPULimit}}
          cpus: "{{.CPUStr}}"
{{- end}}
{{- if .MemLimit}}
          memory: {{.MemStr}}
{{- end}}
{{- end}}
    networks:
      - internal
      - projectnet

  webmail:
    image: docker.io/djmaze/snappymail:latest
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_webmail
    restart: unless-stopped
    depends_on:
      - mail
    volumes:
      - webmail_data:/var/lib/snappymail
    ports:
      - "{{.HostPort}}:8888"
    networks:
      - internal
      - projectnet

volumes:
  mail_data:
  webmail_data:

networks:
  # internal: private to this app (webmail <-> mail by service name).
  internal:
  # projectnet: shared across the project so other apps can reach this one by
  # container name (e.g. an app sending mail via "mail:587"). External; xdev
  # creates it.
  projectnet:
    name: {{.NetworkName}}
    external: true
