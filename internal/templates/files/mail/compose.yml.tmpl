# Generated by xdev — Mail: Stalwart (SMTP/IMAP + admin UI) + SnappyMail webmail
# (+ Rail webmail when switched on in the app's Services tab).
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# First run (bootstrap):
#   - Stalwart boots in bootstrap mode with only its setup port (8080) open and
#     prints an auto-generated admin password in the mail service logs. Reach
#     the setup wizard directly at the host's bootstrap port (see below), run
#     it, then restart the service. After that the admin console + mail
#     listeners come up and the wizard port becomes a recovery endpoint.
#   - Steady state: the admin console serves over HTTPS on 443; the proxy
#     forwards this app's admin domain to it. The wizard also lists the exact
#     MX/SPF/DKIM/DMARC DNS records to create at your DNS provider.
#   - SnappyMail writes its admin password to the webmail volume at
#     _data_/_default_/admin_password.txt. Open /?admin on the app domain and
#     point your domains at IMAP host "mail" port 993 and SMTP "mail" port 465,
#     SSL/TLS with certificate verification off (the certificate names the
#     public hostname, not "mail"; the hop never leaves the host).
services:
  mail:
    # Pinned: 0.16 -> 1.x could not be upgraded in place, so a moving tag can
    # break a live mail server on any pull. Bump deliberately, per release notes.
    image: docker.io/stalwartlabs/stalwart:v1.1.1
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_mail
    restart: unless-stopped
    environment:
      # Public URL of the admin/webmail-login (OAuth) and discovery documents —
      # the admin domain. Without it Stalwart uses its server hostname (the
      # SMTP/EHLO name), which may route somewhere else entirely. xdev writes
      # MAIL_PUBLIC_URL into _/.env on start unless you set it there yourself.
      STALWART_PUBLIC_URL: ${MAIL_PUBLIC_URL}
    volumes:
      # Stalwart keeps all data + config here (RocksDB store, DKIM keys, TLS).
      - mail_data:/var/lib/stalwart
      # TLS certificates xdev copies from the proxy's ACME store, one
      # <host>.crt/<host>.key per MAIL_TLS_HOSTS entry (Env tab). In Stalwart's
      # admin (Settings > TLS > Certificates) add one per host, certificate and
      # private key both of type File: /etc/stalwart/tls/<host>.crt / .key
      - ./tls:/etc/stalwart/tls:ro
    ports:
      # Steady-state admin console + JMAP (HTTPS, self-signed); the proxy (ngx or
      # Caddy) forwards the app's admin domain here over TLS (verification
      # skipped, loopback).
      - "{{.AdminerPort}}:443"
      # Bootstrap/recovery setup UI. Only open (as the sole listener) on first
      # boot until the wizard is completed; reach it directly at this host port.
{{- if eq .Env "prod"}}
      # Every mail port reads a variable from _/.env (Env tab), defaulting to the
      # standard port. While another mail server still holds the standard ports
      # (a migration), xdev writes high-port overrides there at create time so
      # both run side by side. Cutover: delete those lines, restart the app.
      # Loopback only: after setup this is Stalwart's plain-HTTP listener (admin
      # login unencrypted). Reach it over an SSH tunnel; the admin domain serves
      # the same console over HTTPS.
      - "127.0.0.1:${MAIL_SETUP_PORT:-8080}:8080"
      - "${MAIL_SMTP_PORT:-25}:25"            # SMTP (server-to-server delivery)
      - "${MAIL_SUBMISSIONS_PORT:-465}:465"   # SMTPS submission
      - "${MAIL_SUBMISSION_PORT:-587}:587"    # submission (STARTTLS)
      - "${MAIL_IMAP_PORT:-143}:143"          # IMAP (STARTTLS)
      - "${MAIL_IMAPS_PORT:-993}:993"         # IMAPS
      - "${MAIL_POP3_PORT:-110}:110"          # POP3 (STARTTLS)
      - "${MAIL_POP3S_PORT:-995}:995"         # POP3S
      - "${MAIL_SIEVE_PORT:-4190}:4190"       # ManageSieve (filters)
{{- else}}
      - "127.0.0.1:18080:8080"
      # ponytail: high ports locally — rootless podman can't bind <1024.
      - "2525:25"
      - "4650:465"
      - "9930:993"
{{- end}}
{{- if .HasLimits}}
    deploy:
      resources:
        limits:
{{- if .CPULimit}}
          cpus: "{{.CPUStr}}"
{{- end}}
{{- if .MemLimit}}
          memory: {{.MemStr}}
{{- end}}
{{- end}}
    networks:
      - internal
      - projectnet
{{template "webmail_service" .}}{{if .RailPort}}{{template "rail_service" .}}{{end}}
volumes:
  mail_data:
  webmail_data:

networks:
  # internal: private to this app (webmail <-> mail by service name).
  internal:
  # projectnet: shared across the project so other apps can reach this one by
  # container name (e.g. an app sending mail via "mail:587"). External; xdev
  # creates it.
  projectnet:
    name: {{.NetworkName}}
    external: true
