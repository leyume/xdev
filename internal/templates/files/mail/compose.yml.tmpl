# Generated by xdev — Mail: Stalwart (SMTP/IMAP + admin UI) + SnappyMail webmail.
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# First run (bootstrap):
#   - Stalwart boots in bootstrap mode with only its setup port (8080) open and
#     prints an auto-generated admin password in the mail service logs. Reach
#     the setup wizard directly at the host's bootstrap port (see below), run
#     it, then restart the service. After that the admin console + mail
#     listeners come up and the wizard port becomes a recovery endpoint.
#   - Steady state: the admin console serves over HTTPS on 443; Caddy proxies
#     this app's admin domain to it. The wizard also lists the exact
#     MX/SPF/DKIM/DMARC DNS records to create at your DNS provider.
#   - SnappyMail writes its admin password to the webmail volume at
#     _data_/_default_/admin_password.txt. Open /?admin on the app domain and
#     point your domain at IMAP host "mail" port 143, SMTP "mail" port 465.
services:
  mail:
    image: docker.io/stalwartlabs/stalwart:latest
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_mail
    restart: unless-stopped
    volumes:
      # Stalwart keeps all data + config here (RocksDB store, DKIM keys, TLS).
      - mail_data:/var/lib/stalwart
    ports:
      # Steady-state admin console + JMAP (HTTPS, self-signed); Caddy proxies
      # the app's admin domain here over TLS (verification skipped, loopback).
      - "{{.AdminerPort}}:443"
      # Bootstrap/recovery setup UI. Only open (as the sole listener) on first
      # boot until the wizard is completed; reach it directly at this host port.
      # ponytail: fixed host port — there is one mail app per host (it serves all
      # domains), so no collision; give it an allocated port if that changes.
{{- if eq .Env "prod"}}
      - "8080:8080"
      - "25:25"    # SMTP (server-to-server delivery)
      - "465:465"  # SMTPS submission
      - "993:993"  # IMAPS
{{- else}}
      - "18080:8080"
      # ponytail: high ports locally — rootless podman can't bind <1024.
      - "2525:25"
      - "4650:465"
      - "9930:993"
{{- end}}
{{- if .HasLimits}}
    deploy:
      resources:
        limits:
{{- if .CPULimit}}
          cpus: "{{.CPUStr}}"
{{- end}}
{{- if .MemLimit}}
          memory: {{.MemStr}}
{{- end}}
{{- end}}
    networks:
      - internal
      - projectnet

  webmail:
    image: docker.io/djmaze/snappymail:latest
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_webmail
    restart: unless-stopped
    depends_on:
      - mail
    volumes:
      - webmail_data:/var/lib/snappymail
    ports:
      - "{{.HostPort}}:8888"
    networks:
      - internal
      - projectnet

volumes:
  mail_data:
  webmail_data:

networks:
  # internal: private to this app (webmail <-> mail by service name).
  internal:
  # projectnet: shared across the project so other apps can reach this one by
  # container name (e.g. an app sending mail via "mail:587"). External; xdev
  # creates it.
  projectnet:
    name: {{.NetworkName}}
    external: true
