{{/* The bundled database UI (rql, https://hub.docker.com/r/leyume/rql), as one
     compose service. It replaced Adminer; the Go side still calls it "adminer"
     (SetAdminer, AdminerPort, POST /apps/{id}/adminer).

     It lives in a partial rather than inline in the two compose files because
     it is the one service an app can gain or lose after it is created: turning
     it off has to remove exactly this block from a file the user may have
     edited, and turning it back on has to put exactly this block back. A single
     definition keeps "the block xdev removes" and "the block xdev writes" the
     same text, and the local and prod stacks from drifting apart.

     RQL_NO_AUTH: like Adminer, the database login is the gate. rql then answers
     on any hostname, which the proxy in front needs. Never add RQL_SERVERS with
     credentials here: listed servers skip the login.

     Rendered on its own by templates.RenderPartial; included by both compose
     templates behind {{if .AdminerPort}}, since port 0 means "no database UI". */}}
{{define "adminer_service"}}
  rql:
    image: docker.io/leyume/rql:latest
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_rql
    restart: unless-stopped
{{- if not .SharedDB}}
    depends_on:
      - db
{{- end}}
    environment:
      RQL_NO_AUTH: "1"
    ports:
      - "{{.AdminerPort}}:8080"
    networks:
      - internal
{{- if .SharedDB}}
      - shareddb
{{- end}}
{{end}}
