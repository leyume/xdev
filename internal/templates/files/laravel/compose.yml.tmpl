# Generated by xdev — Laravel (Octane/Swoole) + MariaDB + Redis + Adminer.
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# Your Laravel code lives in the bind-mounted app/ dir. On first start xdev
# scaffolds a fresh Laravel install into it (see ensureLaravelBootstrap), then
# this container finishes the job through the mounted _/init.sh — Octane
# install, key:generate, migrate — and serves with Swoole.
#
# The image above is chosen for this host: a local project prefers the -dev
# variant, but that tag is published for arm64 only, so an amd64 machine gets
# the -prod one instead (xdev logs when it substitutes). Set XDEV_LARAVEL_IMAGE
# to pin your own. Either way the composer half of the bootstrap runs outside
# this container, so an image without composer serves perfectly well.
# Redis persists under _volumes/ (bind-mounts, bizepp format).
{{- if .SharedDB}}
#
# Shared-database mode: no db service here — this app's database lives on the
# platform xdev-db MariaDB, reached over the external xdev_shared network.
{{- else}}
# The dedicated MariaDB persists under _volumes/mysql.
{{- end}}
services:
  app:
    image: {{.AppImage}}
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_app
    restart: unless-stopped
    command: ["sh", "/init.sh"]
    depends_on:
{{- if not .SharedDB}}
      - db
{{- end}}
      - redis
    environment:
      APP_ENV: local
      DB_CONNECTION: mysql
{{- if .SharedDB}}
      DB_HOST: xdev-db
      DB_PORT: 3306
      DB_DATABASE: {{.DBName}}
      DB_USERNAME: {{.DBName}}
      DB_PASSWORD: {{.DBPass}}
{{- else}}
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: laravel
      DB_USERNAME: laravel
      DB_PASSWORD: secret
{{- end}}
      REDIS_HOST: redis
    volumes:
      - ../app:/var/www/html
      # storage/ and .env are state, not code: they are mounted from outside
      # app/ so a git deploy (which resets the checkout hard) cannot take user
      # uploads, sessions, logs or the app key with it.
      - ../_volumes/storage:/var/www/html/storage
      - ./laravel.env:/var/www/html/.env
      - ./init.sh:/init.sh:ro
    ports:
      - "{{.HostPort}}:8000"
{{- if .HasLimits}}
    deploy:
      resources:
        limits:
{{- if .CPULimit}}
          cpus: "{{.CPUStr}}"
{{- end}}
{{- if .MemLimit}}
          memory: {{.MemStr}}
{{- end}}
{{- end}}
    networks:
      - internal
      - projectnet
{{- if .SharedDB}}
      - shareddb
{{- end}}
{{- if not .SharedDB}}

  db:
    # Official multi-arch image — the same one the platform database service and
    # the mail stack use. The custom image this replaced was amd64-only and
    # carried no tag, so a dedicated-database Laravel app could not start on an
    # arm64 machine at all, and "latest" meant a different build every pull.
    image: docker.io/library/mariadb:11
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: secret
    volumes:
      - ../_volumes/mysql:/var/lib/mysql
      - ./db/my.cnf:/etc/mysql/conf.d/my.cnf:ro
    networks:
      - internal
{{- end}}

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_redis
    restart: unless-stopped
    volumes:
      - ../_volumes/redis:/data
    networks:
      - internal

  adminer:
    image: docker.io/library/adminer
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_adminer
    restart: unless-stopped
{{- if not .SharedDB}}
    depends_on:
      - db
{{- end}}
    environment:
      ADMINER_DEFAULT_SERVER: {{if .SharedDB}}xdev-db{{else}}db{{end}}
    volumes:
      - ./db/adminer.css:/var/www/html/adminer.css:ro
    ports:
      - "{{.AdminerPort}}:8080"
    networks:
      - internal
{{- if .SharedDB}}
      - shareddb
{{- end}}

# Per-project shared network (created by xdev) plus a private internal network
# for app<->db/redis/adminer traffic.
networks:
  internal:
  projectnet:
    name: {{.NetworkName}}
    external: true
{{- if .SharedDB}}
  # shareddb: platform-wide network where the single xdev-db MariaDB lives.
  shareddb:
    name: xdev_shared
    external: true
{{- end}}
