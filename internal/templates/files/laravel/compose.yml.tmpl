# Generated by xdev — Laravel (Octane/Swoole) + MariaDB + Redis + Adminer.
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# On first start the app container bootstraps a fresh Laravel install via the
# mounted _/init.sh (composer create-project + Octane + key:generate + migrate),
# then serves with Swoole. Your Laravel code lives in the bind-mounted app/ dir.
# Redis persists under _volumes/ (bind-mounts, bizepp format).
{{- if .SharedDB}}
#
# Shared-database mode: no db service here — this app's database lives on the
# platform xdev-db MariaDB, reached over the external xdev_shared network.
{{- else}}
# The dedicated MariaDB persists under _volumes/mysql.
{{- end}}
services:
  app:
    image: docker.io/leyume/swoole:2.0.0-dev
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_app
    restart: unless-stopped
    command: ["sh", "/init.sh"]
    depends_on:
{{- if not .SharedDB}}
      - db
{{- end}}
      - redis
    environment:
      APP_ENV: local
      DB_CONNECTION: mysql
{{- if .SharedDB}}
      DB_HOST: xdev-db
      DB_PORT: 3306
      DB_DATABASE: {{.DBName}}
      DB_USERNAME: {{.DBName}}
      DB_PASSWORD: {{.DBPass}}
{{- else}}
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: laravel
      DB_USERNAME: laravel
      DB_PASSWORD: secret
{{- end}}
      REDIS_HOST: redis
    volumes:
      - ../app:/var/www/html
      - ./init.sh:/init.sh:ro
    ports:
      - "{{.HostPort}}:8000"
{{- if .HasLimits}}
    deploy:
      resources:
        limits:
{{- if .CPULimit}}
          cpus: "{{.CPUStr}}"
{{- end}}
{{- if .MemLimit}}
          memory: {{.MemStr}}
{{- end}}
{{- end}}
    networks:
      - internal
      - projectnet
{{- if .SharedDB}}
      - shareddb
{{- end}}
{{- if not .SharedDB}}

  db:
    image: docker.io/leyume/mariadb
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: secret
    volumes:
      - ../_volumes/mysql:/var/lib/mysql
      - ./db/my.cnf:/etc/mysql/conf.d/my.cnf:ro
    networks:
      - internal
{{- end}}

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_redis
    restart: unless-stopped
    volumes:
      - ../_volumes/redis:/data
    networks:
      - internal

  adminer:
    image: docker.io/library/adminer
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_adminer
    restart: unless-stopped
{{- if not .SharedDB}}
    depends_on:
      - db
{{- end}}
    environment:
      ADMINER_DEFAULT_SERVER: {{if .SharedDB}}xdev-db{{else}}db{{end}}
    volumes:
      - ./db/adminer.css:/var/www/html/adminer.css:ro
    ports:
      - "{{.AdminerPort}}:8080"
    networks:
      - internal
{{- if .SharedDB}}
      - shareddb
{{- end}}

# Per-project shared network (created by xdev) plus a private internal network
# for app<->db/redis/adminer traffic.
networks:
  internal:
  projectnet:
    name: {{.NetworkName}}
    external: true
{{- if .SharedDB}}
  # shareddb: platform-wide network where the single xdev-db MariaDB lives.
  shareddb:
    name: xdev_shared
    external: true
{{- end}}
