# Generated by xdev — Laravel on php-fpm (the "fpm" server option).
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# Two services instead of Octane's one: nginx serves static files and speaks
# FastCGI to php-fpm, which forks a worker per request and reaps it when idle.
# That is the whole difference from the Swoole stack — measured on the same
# Laravel app, idle:
#
#     php-fpm + nginx    48.7 MiB
#     Octane/Swoole     168.6 MiB
#
# The saving is real but it is bought with per-request bootstrap: every request
# builds the framework again (from opcache bytecode, not source). For a site
# with steady concurrent traffic the Swoole stack is usually the better trade —
# each busy fpm worker costs 30-40 MiB, so the advantage narrows under load.
#
# Both services mount the same app/ because nginx serves public/ directly.
{{- if .SharedDB}}
#
# Shared-database mode: no db service here — this app's database lives on the
# platform xdev-db MariaDB, reached over the external xdev_shared network.
{{- else}}
# The dedicated MariaDB persists under _volumes/mysql.
{{- end}}
services:
  php:
    image: {{.AppImage}}
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_php
    restart: unless-stopped
    # Same init.sh as the Swoole stack; XDEV_SERVER makes it skip the Octane
    # install and exec php-fpm at the end instead of octane:start.
    command: ["sh", "/init.sh"]
    depends_on:
{{- if not .SharedDB}}
      - db
{{- end}}
      - redis
    environment:
      XDEV_SERVER: fpm
{{- if eq .Env "prod"}}
      APP_ENV: production
{{- else}}
      APP_ENV: local
{{- end}}
      DB_CONNECTION: mysql
{{- if .SharedDB}}
      DB_HOST: xdev-db
      DB_PORT: 3306
      DB_DATABASE: {{.DBName}}
      DB_USERNAME: {{.DBName}}
      DB_PASSWORD: {{.DBPass}}
{{- else}}
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: laravel
      DB_USERNAME: laravel
      DB_PASSWORD: ${DB_PASSWORD:-secret}
{{- end}}
      REDIS_HOST: redis
      # Ceiling on concurrent PHP workers. Each busy worker is 30-40 MiB, so
      # this is also the memory ceiling: 20 x 40 MiB is 800 MiB before the
      # limit below refuses it.
      PHP_FPM_MAX_CHILDREN: "20"
      PHP_FPM_IDLE_TIMEOUT: "10s"
    volumes:
      - ../app:/var/www/html
      # storage/ and .env are state, not code: mounted from outside app/ so a
      # git deploy (which resets the checkout hard) cannot take user uploads,
      # sessions, logs or the app key with it.
      - ../_volumes/storage:/var/www/html/storage
      - ./laravel.env:/var/www/html/.env
      - ./init.sh:/init.sh:ro
    healthcheck:
      # php-fpm speaks FastCGI, not HTTP, so it cannot be probed with curl.
      # A worker that can boot the framework is the useful liveness signal.
      test: ["CMD", "php", "-r", "exit(0);"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 300s
    deploy:
      resources:
        limits:
          cpus: "{{if .CPULimit}}{{.CPUStr}}{{else}}2.0{{end}}"
          memory: {{if .MemLimit}}{{.MemStr}}{{else}}1g{{end}}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal
{{- if .SharedDB}}
      - shareddb
{{- end}}

  web:
    image: docker.io/library/nginx:alpine
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_web
    restart: unless-stopped
    depends_on:
      - php
    volumes:
      # Read-only: nginx serves public/ and must never be able to write to the
      # checkout. php-fpm has the writable mount.
      - ../app:/var/www/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "{{.HostPort}}:80"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1/up"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 300s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal
      - projectnet
{{- if not .SharedDB}}

  db:
    image: docker.io/library/mariadb:11
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
    volumes:
      - ../_volumes/mysql:/var/lib/mysql
      - ./db/my.cnf:/etc/mysql/conf.d/my.cnf:ro
    networks:
      - internal
{{- end}}

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru"]
    volumes:
      - ../_volumes/redis:/data
    networks:
      - internal
{{if .AdminerPort}}{{template "adminer_service" .}}{{end}}
networks:
  internal:
  projectnet:
    name: {{.NetworkName}}
    external: true
{{- if .SharedDB}}
  # shareddb: platform-wide network where the single xdev-db MariaDB lives.
  shareddb:
    name: xdev_shared
    external: true
{{- end}}
