# Generated by xdev — Laravel PRODUCTION stack (selected when the project's
# environment is "prod"). Ported from the bizepp compose.prod.yml.
# Project: {{.ProjectSlug}}   App: {{.AppSlug}}
#
# Uses the hardened Swoole prod image. Like the local stack it boots through the
# mounted _/init.sh, which bootstraps a Laravel install only when app/ has none
# (a freshly created app) and otherwise goes straight to serving — so deploying
# built code stays a no-op boot, and creating an app in a prod project still
# gives you something that runs. APP_ENV=production makes init.sh install
# without dev dependencies and cache config/routes.
# Redis persists under _volumes/ (bind-mounts, bizepp format).
{{- if .SharedDB}}
#
# Shared-database mode: no db service here — this app's database lives on the
# platform xdev-db MariaDB, reached over the external xdev_shared network.
{{- else}}
# The dedicated MariaDB persists under _volumes/mysql.
{{- end}}
services:
  app:
    image: docker.io/leyume/swoole:2.0.0-prod
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_app
    restart: unless-stopped
    command: ["sh", "/init.sh"]
    depends_on:
{{- if not .SharedDB}}
      - db
{{- end}}
      - redis
    environment:
      APP_ENV: production
      DB_CONNECTION: mysql
{{- if .SharedDB}}
      DB_HOST: xdev-db
      DB_PORT: 3306
      DB_DATABASE: {{.DBName}}
      DB_USERNAME: {{.DBName}}
      DB_PASSWORD: {{.DBPass}}
{{- else}}
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: laravel
      DB_USERNAME: laravel
      DB_PASSWORD: ${DB_PASSWORD:-secret}
{{- end}}
      REDIS_HOST: redis
    volumes:
      # Read-write: Laravel needs to write storage/ and bootstrap/cache/ at
      # runtime, and init.sh bootstraps into an empty app/ on first boot. A
      # `:ro` code mount with named volumes carved out of it can't work here —
      # the mountpoints don't exist in an empty app/, so the container fails to
      # start ("mkdir /var/www/html/storage: read-only file system").
      - ../app:/var/www/html
      - ./init.sh:/init.sh:ro
    ports:
      - "{{.HostPort}}:8000"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8000/up"]
      interval: 30s
      timeout: 5s
      retries: 3
      # Generous: a first boot bootstraps Laravel over composer before /up
      # answers. Later boots serve immediately and pass on the first probe.
      start_period: 300s
    deploy:
      resources:
        limits:
          cpus: "{{if .CPULimit}}{{.CPUStr}}{{else}}2.0{{end}}"
          memory: {{if .MemLimit}}{{.MemStr}}{{else}}1g{{end}}
        reservations:
          memory: 256m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal
      - projectnet
{{- if .SharedDB}}
      - shareddb
{{- end}}
{{- if not .SharedDB}}

  db:
    image: docker.io/leyume/mariadb
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
      MYSQL_DATABASE: laravel
      MYSQL_USER: laravel
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
    volumes:
      - ../_volumes/mysql:/var/lib/mysql
      - ./db/my.cnf:/etc/mysql/conf.d/my.cnf:ro
    networks:
      - internal
{{- end}}

  redis:
    image: docker.io/library/redis:7-alpine
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru"]
    volumes:
      - ../_volumes/redis:/data
    networks:
      - internal

  adminer:
    image: docker.io/library/adminer
    container_name: {{.ProjectSlug}}_{{.AppSlug}}_adminer
    restart: unless-stopped
{{- if not .SharedDB}}
    depends_on:
      - db
{{- end}}
    environment:
      ADMINER_DEFAULT_SERVER: {{if .SharedDB}}xdev-db{{else}}db{{end}}
    volumes:
      - ./db/adminer.css:/var/www/html/adminer.css:ro
    ports:
      - "{{.AdminerPort}}:8080"
    networks:
      - internal
{{- if .SharedDB}}
      - shareddb
{{- end}}

networks:
  internal:
  projectnet:
    name: {{.NetworkName}}
    external: true
{{- if .SharedDB}}
  # shareddb: platform-wide network where the single xdev-db MariaDB lives.
  shareddb:
    name: xdev_shared
    external: true
{{- end}}
